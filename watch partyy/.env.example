# MongoDB Atlas connection string. Leave blank to use in-memory rooms locally.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=youtube_watch_party

